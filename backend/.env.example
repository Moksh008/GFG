# Copy to backend/.env and fill in. Everything is optional — the API runs with no keys
# (SQLite + local AI fallbacks). Add keys to unlock the full experience.

# --- Database: NeonDB / Postgres (omit to use local SQLite at backend/dermora.db)
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dermora?sslmode=require

# --- Google Gemini (Aria chat, Solace voice, AI summaries, sentiment analysis)
# GEMINI_API_KEY=
# Comma-separated; tried in order, later ones are fallbacks when a model is overloaded.
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
# Optional — only if your key has these models. Empty = browser voice for replies / no live voice.
# GEMINI_TTS_MODEL=
# GEMINI_TTS_VOICE=Kore
# GEMINI_LIVE_MODEL=

# --- Azure AI Vision (optional: verifies photos actually show skin)
# AZURE_VISION_KEY=
# AZURE_VISION_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# --- Blockchain report verification (verifiable doctor PDFs)
# ""      = off (fingerprints kept in the database only)
# "local" = in-process dev chain, contract auto-deployed (resets when the API restarts)
# https://… = real network, e.g. Base Sepolia — run scripts/deploy_registry.py (wallet → fund → deploy)
WEB3_RPC_URL=local
# WEB3_PRIVATE_KEY=            # Dermora issuer wallet (pays gas) — created by deploy_registry.py wallet
# REPORT_REGISTRY_ADDRESS=     # written by deploy_registry.py deploy
# WEB3_NETWORK_NAME=Base Sepolia
# WEB3_EXPLORER_URL=https://sepolia.basescan.org
# Public URL of the web app, printed + QR-encoded in PDFs for doctors to verify
PUBLIC_APP_URL=http://localhost:5173

# --- Weather uses Open-Meteo: free, no key required.

# --- Skin model (auto-downloaded from Hugging Face on first start if missing)
# MODEL_PATH=app/models/weights/dermora-dinov2-vit-b-skin-improved.pth
# MODEL_DEVICE=auto            # auto | cpu | cuda
# FIELD_OF_VIEW_CM=8.0         # approx. width of a close-up photo, for cm² estimates

# --- Security (CHANGE IN PRODUCTION: python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Storage / server
UPLOAD_DIR=uploads/skin_images
AUDIO_DIR=convo_audios
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost
SEED_DEMO_DATA=true
DEMO_EMAIL=alex@dermora.ai
DEMO_PASSWORD=dermora-demo
